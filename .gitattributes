* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.ini text eol=lf
VERSION text eol=lf
# Preserve exact upstream license evidence and its recorded hashes.
licenses/** -text -whitespace
mac-app/ThirdParty/MMKV-LICENSE.txt -text -whitespace

# Preserve archived patch bytes, including required blank context-line prefixes.
docs/proposals/*.patch -text -whitespace
# Archived source patches retain exact hashes and required context-line spaces.
docs/development/*.patch -text -whitespace
# Archived CRLF source is hash-verified; do not rewrite its whitespace.
docs/development/tab5-262-source/** -whitespace

# Preserve the accepted TAB5 source snapshot and its recorded byte hashes.
docs/development/tab5-279-source/** -text -whitespace
