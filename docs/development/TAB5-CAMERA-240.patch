+    fail_at=failure;call_index=query_count=logged_bytes=0;diagnostic[0]=0;
+}
+int main(void) {
+    const struct esp_video_buffer_info info={3,1280*720*2,64,
+        MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT|MALLOC_CAP_CACHE_ALIGNED,V4L2_MEMORY_MMAP};
