+#include <stdarg.h>
+#include <string.h>
+#define MALLOC_CAP_8BIT 4
+#define MALLOC_CAP_SPIRAM 1024
+#define MALLOC_CAP_CACHE_ALIGNED (1u << 19)
+#define V4L2_MEMORY_MMAP 1
