+# Bound the competing LCD framebuffer copy path after dma2d_connect resets
+# each channel to its SDK default (128 bytes). Scanout timing is unchanged.
+copy_driver = root / 'components/esp_lcd/src/esp_async_fbcpy.c'
+source = copy_driver.read_text(encoding='utf-8')
+marker = '/* TAB5 bounded framebuffer copy */'
+if marker not in source:
+    replacements = (
+        ('    dma2d_start(tx_chan);',
+         '    ' + marker + '\n'
+         '    dma2d_transfer_ability_t ability = {.data_burst_length = DMA2D_DATA_BURST_LENGTH_32};\n'
+         '    ESP_ERROR_CHECK(dma2d_set_transfer_ability(tx_chan, &ability));\n'
+         '    ESP_ERROR_CHECK(dma2d_set_transfer_ability(rx_chan, &ability));\n'
+         '    extern void tab5_lcd_copy_begin(unsigned) __attribute__((weak));\n'
+         '    if (tab5_lcd_copy_begin) tab5_lcd_copy_begin(mcp->tx_desc->hb_length * mcp->tx_desc->vb_size);\n'
+         '    dma2d_start(tx_chan);'),
+        ('    if (mcp->memcpy_done_cb) {',
+         '    extern void tab5_lcd_copy_end(void) __attribute__((weak));\n'
+         '    if (tab5_lcd_copy_end) tab5_lcd_copy_end();\n'
+         '    if (mcp->memcpy_done_cb) {'),
+    )
+    for old,new in replacements:
+        if source.count(old) != 1:
+            raise SystemExit('Unexpected pinned framebuffer copy driver; inspect before applying.')
+        source = source.replace(old,new)
+    copy_driver.write_text(source,encoding='utf-8')
+print('TAB5 framebuffer copy burst limited to 32 bytes; in-flight diagnostics ready')
