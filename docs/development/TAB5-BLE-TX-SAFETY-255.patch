+target_include_directories(ble-att-tx-failure-test PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
+file(READ "${HCI_TX_SOURCE}" HCI_TX_TEXT)
+string(FIND "${HCI_TX_TEXT}" "// TAB5_HOSTED_HCI_STAGING\n" HCI_HELPER_START)
+string(FIND "${HCI_TX_TEXT}" "// TAB5_HOSTED_HCI_STAGING_END" HCI_HELPER_END)
+string(FIND "${HCI_TX_TEXT}" "int ble_transport_to_ll_acl_impl(" HCI_TX_START)
+string(FIND "${HCI_TX_TEXT}" "#endif // H_BT_HOST_ESP_NIMBLE" HCI_TX_END)
+if(HCI_HELPER_START LESS 0 OR HCI_HELPER_END LESS HCI_HELPER_START OR HCI_TX_START LESS 0 OR HCI_TX_END LESS HCI_TX_START)
+    message(FATAL_ERROR "Pinned Hosted HCI TX markers changed")
+endif()
+math(EXPR HCI_HELPER_LENGTH "${HCI_HELPER_END}-${HCI_HELPER_START}")
+math(EXPR HCI_TX_LENGTH "${HCI_TX_END}-${HCI_TX_START}")
+string(SUBSTRING "${HCI_TX_TEXT}" ${HCI_HELPER_START} ${HCI_HELPER_LENGTH} HCI_TX_HELPER)
+string(SUBSTRING "${HCI_TX_TEXT}" ${HCI_TX_START} ${HCI_TX_LENGTH} HCI_TX_BODY)
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/hosted_hci_helper_under_test.inc" "${HCI_TX_HELPER}")
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/hosted_hci_tx_under_test.inc" "${HCI_TX_BODY}")
+foreach(P4 0 1)
+    add_executable(hosted-hci-tx-test-${P4} hosted_hci_tx_test.c)
+    target_compile_definitions(hosted-hci-tx-test-${P4} PRIVATE CONFIG_IDF_TARGET_ESP32P4=${P4})
+    target_include_directories(hosted-hci-tx-test-${P4} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
+endforeach()
