 static bool health_bridge_fresh(void) {
-    return last_received>0&&esp_timer_get_time()/1000-last_received<8000;
+    int64_t now=esp_timer_get_time()/1000;
+    // Rendering is deferred during gestures. Link freshness follows the
+    // authenticated receive timestamps even while the visible snapshot waits.
+    if(xSemaphoreTake(device_mutex,0)) {
+        bool fresh=link_state_active(&device_links,now)!=LINK_NONE;
+        xSemaphoreGive(device_mutex);
+        return fresh;
+    }
+    return last_received>0&&now>=last_received&&now-last_received<8000;
 }
 static const char *health_stale_title(void) {
     return health_bridge_fresh()?"监控数据已过期":"桥接连接已中断";
