diff --git a/firmware/main/scanout_history.h b/firmware/main/scanout_history.h
new file mode 100644
index 0000000..fecd733
--- /dev/null
+++ b/firmware/main/scanout_history.h
@@ -0,0 +1,51 @@
+#pragma once
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+enum {
+    TAB5_HISTORY_SLOTS=8, TAB5_HISTORY_MAX_EVENTS=12, TAB5_HISTORY_MAX_AGE_US=50000,
+    TAB5_HISTORY_COPY_BEGIN=1, TAB5_HISTORY_COPY_END,
+    TAB5_HISTORY_RENDER_BEGIN, TAB5_HISTORY_RENDER_END,
+    TAB5_HISTORY_ROTATE_BEGIN, TAB5_HISTORY_ROTATE_END,
+    TAB5_HISTORY_SUBMIT_BEGIN, TAB5_HISTORY_SUBMIT_END
+};
+
+typedef struct { unsigned ticket,tag,frame,at; } tab5_history_slot;
+typedef struct { unsigned head; tab5_history_slot slots[TAB5_HISTORY_SLOTS]; } tab5_history;
+typedef struct { unsigned tag,frame_age,age_us; } tab5_history_event;
+
+// Each ring has a single ordered producer. Copy EOF publishes before the
+// completion callback can admit another copy. UI marks run in the LVGL task.
+static inline __attribute__((always_inline)) void tab5_history_mark(
+        tab5_history *ring,unsigned kind,unsigned frame,unsigned latch,unsigned at) {
+    unsigned ticket=__atomic_load_n(&ring->head,__ATOMIC_RELAXED)+1;
+    tab5_history_slot *slot=&ring->slots[(ticket-1)&(TAB5_HISTORY_SLOTS-1)];
+    __atomic_store_n(&slot->ticket,0,__ATOMIC_RELAXED);
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    __atomic_store_n(&slot->tag,kind*4+latch,__ATOMIC_RELAXED);
+    __atomic_store_n(&slot->frame,frame,__ATOMIC_RELAXED);
+    __atomic_store_n(&slot->at,at,__ATOMIC_RELAXED);
+    __atomic_store_n(&slot->ticket,ticket,__ATOMIC_RELEASE);
+    __atomic_store_n(&ring->head,ticket,__ATOMIC_RELEASE);
+}
+
+// The consumer never waits for a writer. Reject overwritten/torn, future,
+// and unrelated old records, including across timer and frame-counter wrap.
+static inline __attribute__((always_inline)) unsigned tab5_history_collect(
+        const tab5_history *ring,unsigned at,unsigned frame,tab5_history_event *out,unsigned limit) {
+    unsigned head=__atomic_load_n(&ring->head,__ATOMIC_ACQUIRE),used=0;
+    for(unsigned i=0;i<TAB5_HISTORY_SLOTS&&used<limit;i++) {
+        unsigned ticket=head-i;
+        const tab5_history_slot *slot=&ring->slots[(ticket-1)&(TAB5_HISTORY_SLOTS-1)];
+        if(!ticket||__atomic_load_n(&slot->ticket,__ATOMIC_ACQUIRE)!=ticket)continue;
+        unsigned tag=__atomic_load_n(&slot->tag,__ATOMIC_RELAXED);
+        unsigned frame_age=frame-__atomic_load_n(&slot->frame,__ATOMIC_RELAXED);
+        unsigned age=at-__atomic_load_n(&slot->at,__ATOMIC_RELAXED);
+        __atomic_thread_fence(__ATOMIC_SEQ_CST);
+        if(__atomic_load_n(&slot->ticket,__ATOMIC_ACQUIRE)!=ticket||
+           frame_age>8||age>TAB5_HISTORY_MAX_AGE_US)continue;
+        out[used++]=(tab5_history_event){tag,frame_age,age};
+    }
+    return used;
+}
