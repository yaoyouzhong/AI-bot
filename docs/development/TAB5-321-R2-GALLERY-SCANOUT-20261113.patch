+    FILE *f=store_fopen(w->paths[0],"rb");
+    if(!f){io_error();return NULL;}
+    if(store_fread(header,1,GUIDE_BATCH_HEADER,f)==GUIDE_BATCH_HEADER&&!memcmp(header,"AIBGB002",8)&&
+       u32(header+8)>0&&u32(header+8)<=4096)return f;
+    if(ferror(f))io_error();
+    fclose(f);return NULL;
+}
+
+bool gallery_guide_batch_summary(const char *root,int category,const char *revision,const char *images,uint8_t *hashes,unsigned works) {
+    media_error=false;
+    gallery_paths *w=path_workspace();if(!w)return false;
+    uint8_t header[GUIDE_BATCH_HEADER],entry[GUIDE_BATCH_ENTRY];
+    FILE *f=guide_batch_open(w,root,category,revision,header);
+    bool ok=f&&u32(header+8)==works&&!memcmp(header+76,images,64);
+    for(unsigned i=0;ok&&i<works;i++) {
+        ok=store_fread(entry,1,sizeof(entry),f)==sizeof(entry);
+        if(ok)memcpy(hashes+i*32,entry,32);
+    }
+    if(f&&fclose(f))ok=false;
+    free(w);return ok;
+}
+
+static cJSON *guide_batch_read(const char *root,const gallery_image *key,const char *revision,const char *work_id) {
+    gallery_paths *w=path_workspace();if(!w)return NULL;
+    uint8_t header[GUIDE_BATCH_HEADER],entry[GUIDE_BATCH_ENTRY],hash[32];
+    FILE *f=guide_batch_open(w,root,key->category,revision,header);
+    unsigned index=0;
+    char date[11];
+    // The key is already normalized to the catalog's canonical date.
+    if(f&&gallery_catalog_key(key->date,4096,date)&&!strcmp(date,key->date)) {
+        unsigned lo=0,hi=4096;
+        while(lo<hi){
+            unsigned mid=(lo+hi)/2;gallery_catalog_date(mid,date);
+            if(strcmp(date,key->date)<0)lo=mid+1;else hi=mid;
+        }
+        index=lo;
+    }else index=4096;
+    cJSON *result=NULL;
+    if(f&&index<u32(header+8)&&!fseek(f,GUIDE_BATCH_HEADER+index*GUIDE_BATCH_ENTRY,SEEK_SET)&&
+       store_fread(entry,1,sizeof(entry),f)==sizeof(entry)) {
+        unsigned offset=u32(entry+32),size=u32(entry+36);
+        if(size&&size<=65536&&offset>=GUIDE_BATCH_HEADER+u32(header+8)*GUIDE_BATCH_ENTRY&&offset<=GUIDE_BATCH_LIMIT-size&&
+           !fseek(f,offset,SEEK_SET)) {
+            char *json=malloc(size+1);
+            if(json&&store_fread(json,1,size,f)==size&&!mbedtls_sha256((uint8_t *)json,size,hash,0)&&!memcmp(hash,entry,32)){
+                json[size]=0;result=cJSON_ParseWithLength(json,size+1);
+                if(result&&strcmp(text(result,"workId"),work_id)){cJSON_Delete(result);result=NULL;}
+            }
+            free(json);
+        }
+    }
+    if(f&&fclose(f))io_error();
+    free(w);return result;
+}
+
+bool gallery_guide_batch_save(const char *root,int category,const char *revision,const uint8_t *data,size_t size,unsigned works,unsigned changed) {
+    media_error=false;
+    if(!data||!works||works>4096||size<GUIDE_BATCH_HEADER+works*GUIDE_BATCH_ENTRY||size>GUIDE_BATCH_LIMIT||
+       memcmp(data,"AIBGB002",8)||u32(data+8)!=works)return false;
+    size_t next=GUIDE_BATCH_HEADER+works*GUIDE_BATCH_ENTRY;
+    unsigned records=0;
+    for(unsigned i=0;i<works;i++) {
+        const uint8_t *entry=data+GUIDE_BATCH_HEADER+i*GUIDE_BATCH_ENTRY;
+        unsigned offset=u32(entry+32),bytes=u32(entry+36);
+        if(!bytes){if(offset)return false;continue;}
+        uint8_t hash[32];
+        if(offset!=next||bytes>65536||bytes>size-next||mbedtls_sha256(data+offset,bytes,hash,0)||memcmp(hash,entry,32))return false;
+        next+=bytes;records++;
+    }
+    if(next!=size||records!=changed)return false;
