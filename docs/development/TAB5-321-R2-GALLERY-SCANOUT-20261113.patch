+    bool ok=guide_delta_path(w->paths[0],root,category,revision,"batch");
+    if(ok)snprintf(w->temp,sizeof(w->temp),"%s.part",w->paths[0]);
+    FILE *f=ok?store_fopen(w->temp,"wb"):NULL;
+    ok=f&&store_fwrite(data,1,size,f)==size&&fflush(f)==0&&store_sync_profiled(f)==0;
+    if(f&&fclose(f))ok=false;
+    if(ok&&remove(w->paths[0])&&errno!=ENOENT)ok=false;
+    if(ok&&rename(w->temp,w->paths[0]))ok=false;
+    if(!ok&&*w->temp){io_error();remove(w->temp);}
+    free(w);return ok;
+}
+
+static cJSON *guide_delta_record(const char *path) {
+    FILE *f=store_fopen(path,"rb");
+    if(!f){io_error();return NULL;}
+    uint8_t header[36],hash[32];
+    bool header_ok=store_fread(header,1,sizeof(header),f)==sizeof(header);
+    size_t size=header_ok?u32(header):0;
+    char *json=size&&size<=META_LIMIT?malloc(size+1):NULL;
+    cJSON *value=NULL;
+    if(json&&store_fread(json,1,size,f)==size&&fgetc(f)==EOF&&!ferror(f)&&
+       !mbedtls_sha256((uint8_t *)json,size,hash,0)&&!memcmp(hash,header+4,32)) {
+        json[size]=0;value=cJSON_ParseWithLength(json,size+1);
+    }
+    if(ferror(f))io_error();
+    if(fclose(f)){io_error();cJSON_Delete(value);value=NULL;}
+    free(json);return value;
+}
+
+static bool guide_delta_write(gallery_paths *w,cJSON *value) {
+    char *json=cJSON_PrintUnformatted(value);
+    size_t size=json?strlen(json):0;
+    uint8_t header[36];set32(header,size);
+    bool ok=size&&size<=META_LIMIT&&!mbedtls_sha256((uint8_t *)json,size,header+4,0);
+    snprintf(w->temp,sizeof(w->temp),"%s.part",w->paths[0]);
+    FILE *f=ok?store_fopen(w->temp,"wb"):NULL;
+    ok=f&&store_fwrite(header,1,sizeof(header),f)==sizeof(header)&&store_fwrite(json,1,size,f)==size&&
+        fflush(f)==0&&store_sync_profiled(f)==0;
+    if(f&&fclose(f))ok=false;
+    if(ok&&remove(w->paths[0])&&errno!=ENOENT)ok=false;
+    if(ok&&rename(w->temp,w->paths[0]))ok=false;
+    if(!ok){io_error();remove(w->temp);}
+    free(json);return ok;
+}
+
+static unsigned guide_delta_chain(const char *root,int category,const char *revision,char chain[8][65]) {
+    if(!revision||strlen(revision)!=64)return 0;
+    gallery_paths *w=path_workspace();if(!w)return 0;
+    unsigned count=0;
+    const char *current=revision;
+    while(count<8&&guide_delta_path(w->paths[0],root,category,current,NULL)) {
+        cJSON *link=guide_delta_record(w->paths[0]);
+        const char *previous=cJSON_GetStringValue(link);
+        bool valid=previous&&strlen(previous)==64&&revision_ok(previous)&&strcmp(previous,revision);
+        for(unsigned i=0;valid&&i<count;i++)valid=strcmp(previous,chain[i])!=0;
+        if(valid){memcpy(chain[count],previous,65);current=chain[count++];}
+        cJSON_Delete(link);
+        if(!valid)break;
+    }
+    free(w);return count;
+}
+
+static cJSON *guide_delta_read(const char *root,const gallery_image *key,const char *revision,const char *work_id) {
+    gallery_paths *w=path_workspace();if(!w)return NULL;
+    cJSON *value=guide_delta_path(w->paths[0],root,key->category,revision,key->date)?guide_delta_record(w->paths[0]):NULL;
+    const cJSON *guide=cJSON_GetObjectItemCaseSensitive(value,"guide");
+    const char *stored_id=text(value,"workId");
+    if(value&&(!*stored_id||(work_id&&strcmp(stored_id,work_id))||(!cJSON_IsNull(guide)&&
+       (!cJSON_IsObject(guide)||strcmp(text((cJSON *)guide,"workId"),stored_id))))) {
+        cJSON_Delete(value);value=NULL;
+    }
+    free(w);return value;
+}
+bool gallery_guide_delta_saved(const char *root,const gallery_image *key,const char *revision) {
+    media_error=false;
+    cJSON *saved=guide_delta_read(root,key,revision,NULL);
+    bool ok=saved!=NULL;cJSON_Delete(saved);return ok;
+}
+
+bool gallery_guide_delta_save(const char *root,const gallery_image *key,const char *revision,const gallery_guide *guide) {
