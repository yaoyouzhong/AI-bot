+    if(usage>=0x1e&&usage<=0x27)return (modifier&2)?"!@#$%^&*()"[usage-0x1e]:"1234567890"[usage-0x1e];
+    if(usage==0x2c)return ' ';
+    if(usage>=0x2d&&usage<=0x38)return (modifier&2)?"_+{}|~:\"~<>?"[usage-0x2d]:"-=[]\\#;'`,./"[usage-0x2d];
+    return 0;
+}
