+import Foundation
+import XCTest
+@testable import AIBotBridge
+
+final class MacTab5HostBindingTests: XCTestCase {
+    func testClaimsAreBoundToExistingKeyDeviceNonceAndEndpoint() throws {
+        let pair = MacTab5Pairing(deviceId: "e8f60ae2ec56", usbPath: "/dev/cu.test", key: Data(repeating: 0x11, count: 32), confirmed: true)
+        let nonce = "0123456789abcdef0123456789abcdef"
+        let id = MacTab5HostBinding.id(pair)
+        XCTAssertEqual(id, "246dd3f8363795589894eb1dc61b2e34")
+        let claim = try MacTab5HostBinding.claim(pair, nonce: nonce, address: "192.168.1.20", port: 18765, name: "Windows")
+        XCTAssertEqual(claim["hostId"] as? String, id)
+        XCTAssertEqual(claim["proof"] as? String, MacTab5Protocol.proof(key: pair.key, message: "TAB5_HOST_V1|\(pair.deviceId)|\(id)|\(nonce)|192.168.1.20|18765|Windows"))
+        let reply: [String: Any] = ["deviceId": pair.deviceId, "hostId": id,
+                                   "proof": MacTab5Protocol.proof(key: pair.key, message: "TAB5_HOST_ACK_V1|\(pair.deviceId)|\(id)|\(nonce)")]
+        try MacTab5HostBinding.confirm(reply, pair: pair, nonce: nonce)
+        XCTAssertThrowsError(try MacTab5HostBinding.confirm(reply, pair: pair, nonce: String(repeating: "a", count: 32)))
+        var foreign = pair
+        foreign = MacTab5Pairing(deviceId: pair.deviceId, usbPath: pair.usbPath, key: Data(repeating: 0x22, count: 32), confirmed: true)
+        XCTAssertThrowsError(try MacTab5HostBinding.confirm(reply, pair: foreign, nonce: nonce))
+        XCTAssertThrowsError(try MacTab5HostBinding.claim(pair, nonce: nonce, address: "", port: 0, name: "bad|name"))
+        XCTAssertLessThanOrEqual(MacTab5HostBinding.name(String(repeating: "电脑😀", count: 30)).utf8.count, 63)
+        XCTAssertEqual(pair.key, Data(repeating: 0x11, count: 32))
+        let owner = try MacTab5Protocol.json(["version": 1, "hostId": id])
+        XCTAssertTrue(try MacTab5BLEWire.isSelectedHost(owner, pair: pair))
+        XCTAssertFalse(try MacTab5BLEWire.isSelectedHost(owner, pair: foreign))
+        XCTAssertThrowsError(try MacTab5HostBinding.confirm(["error": "device_busy"], pair: pair, nonce: nonce))
+    }
+}
