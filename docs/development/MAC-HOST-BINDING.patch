+import Foundation
+
+// The Keychain pairing key remains unchanged, including during migration.
+enum MacTab5HostBinding {
+    static func id(_ pair: MacTab5Pairing) -> String {
+        String(MacTab5Protocol.proof(key: pair.key, message: "AIBOT_TAB5_HOST_V1").prefix(32))
+    }
+    static func name(_ input: String) -> String {
+        var value = ""
+        for scalar in input.unicodeScalars {
+            let next = scalar.value < 32 || scalar.value == 127 || scalar.value == 124 ? " " : String(scalar)
+            if value.utf8.count + next.utf8.count > 63 { break }
+            value += next
+        }
+        return value.isEmpty ? "Mac" : value
+    }
+    static func claim(_ pair: MacTab5Pairing, nonce: String, address: String, port: UInt16, name: String) throws -> [String: Any] {
+        guard MacTab5Protocol.isHex(nonce, count: 32), (1...63).contains(name.utf8.count),
+              !name.unicodeScalars.contains(where: { $0.value < 32 || $0.value == 127 || $0.value == 124 }) else { throw MacTab5Error.invalidPacket }
+        let host = id(pair)
+        let message = "TAB5_HOST_V1|\(pair.deviceId)|\(host)|\(nonce)|\(address)|\(port)|\(name)"
+        return ["version": 1, "type": "tab5_host_claim", "deviceId": pair.deviceId, "hostId": host,
+                "nonce": nonce, "host": address, "port": Int(port), "name": name,
+                "proof": MacTab5Protocol.proof(key: pair.key, message: message)]
+    }
+    static func confirm(_ reply: [String: Any], pair: MacTab5Pairing, nonce: String) throws {
+        if reply["error"] as? String == "device_busy" { throw MacTab5Error.busy }
+        guard reply["deviceId"] as? String == pair.deviceId, reply["hostId"] as? String == id(pair),
+              let proof = reply["proof"] as? String,
+              MacTab5Protocol.verify(key: pair.key, message: "TAB5_HOST_ACK_V1|\(pair.deviceId)|\(id(pair))|\(nonce)", proof: proof) else { throw MacTab5Error.hostNotTrusted }
+    }
+}
