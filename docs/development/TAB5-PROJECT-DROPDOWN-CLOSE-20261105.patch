+static void check_project_dropdown_navigation(void) {
+ const char *fixture="{\"epochMilliseconds\":1793758000000,\"pcInput\":{\"session\":\"dropdown-fixture\"},\"codexTasks\":{\"projects\":[{\"id\":\"1111111111111111\",\"name\":\"Codex A\"},{\"id\":\"4444444444444444\",\"name\":\"Codex B\"}],\"tasks\":[{\"id\":\"11111111-1111-4111-8111-111111111111\",\"projectId\":\"1111111111111111\",\"title\":\"Codex navigation\"}]},\"claudeTasks\":{\"projects\":[{\"id\":\"2222222222222222\",\"name\":\"Claude A\"},{\"id\":\"5555555555555555\",\"name\":\"Claude B\"}],\"tasks\":[{\"id\":\"22222222-2222-4222-8222-222222222222\",\"projectId\":\"2222222222222222\",\"title\":\"Claude navigation\"}]}}";
+ cJSON_Delete(shown);shown=cJSON_Parse(fixture);assert(shown);
+ for(unsigned client=0;client<2;client++) {
+  workspace_client=client;codex_selected[0]=0;codex_project_selected[0]=0;
+  codex_default_pending=codex_default_all=true;page(8);render_codex();
+  char selected[37],project[17];snprintf(selected,sizeof(selected),"%s",codex_selected);snprintf(project,sizeof(project),"%s",codex_project_selected);
+  assert(selected[0]&&project[0]);
+  codex_set_text(client?"Claude retained draft":"Codex retained draft");
+  codex_draft *draft=codex_draft_for(selected,true);assert(draft);
+  assert(codex_store_text(draft,lv_textarea_get_text(codex_input),false));draft->loaded=true;draft->dirty=false;
+  lv_dropdown_open(codex_project_picker);assert(lv_dropdown_is_open(codex_project_picker));
+  capture(client?"dropdown-claude-open":"dropdown-codex-open");
+  page(0);
+  capture(client?"dropdown-claude-overview":"dropdown-codex-overview");
+  assert(!lv_dropdown_is_open(codex_project_picker));
+  assert(!strcmp(selected,codex_selected)&&!strcmp(project,codex_project_selected));
+  page(8);assert(!lv_dropdown_is_open(codex_project_picker));
+  assert(!strcmp(lv_textarea_get_text(codex_input),client?"Claude retained draft":"Codex retained draft"));
+  capture(client?"dropdown-claude-return":"dropdown-codex-return");
+  lv_dropdown_open(codex_project_picker);assert(lv_dropdown_is_open(codex_project_picker));
