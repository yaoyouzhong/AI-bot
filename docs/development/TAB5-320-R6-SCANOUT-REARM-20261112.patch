+    old = ('        // when an underrun happens, the LCD display may already becomes blue\n'
+           "        // it's too late to recover the display, so we just print an error message\n"
+           '        // as a hint to the user that he should optimize the memory bandwidth (with AXI-ICM)\n'
+           '        ESP_DRAM_LOGE(TAG, "can\'t fetch data from external memory fast enough, underrun happens");')
+    if source.count(old) != 1:
+        raise SystemExit('Unexpected DPI underrun path; inspect before removing ISR logging.')
+    source = source.replace(old, '        ' + rearm_marker)
