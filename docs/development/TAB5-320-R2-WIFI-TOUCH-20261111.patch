+typedef struct {int64_t until;unsigned owner;} tab5_wifi_test_lease;
+
+static inline bool wifi_test_link_fresh(const link_state *links,int64_t now) {
+    int64_t received=links->received_ms[LINK_WIFI];
+    return received>=0&&now>=received&&now-received<8000;
+}
+static inline bool wifi_test_can_start(const link_state *links,const tab5_wifi_test_lease *lease,int64_t now) {
+    return !lease->until&&link_state_active(links,now)==LINK_USB&&wifi_test_link_fresh(links,now);
+}
+static inline bool wifi_test_should_restore(const link_state *links,const tab5_wifi_test_lease *lease,
+    unsigned owner,bool changing,int64_t now) {
+    return lease->until&&(now>=lease->until||lease->owner!=owner||changing||!wifi_test_link_fresh(links,now));
+}
