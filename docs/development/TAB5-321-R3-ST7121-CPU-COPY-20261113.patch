+
+
+# Bound the task-context RGB565 copy on panels using the CPU path.
+# The existing color-done callback still fires once after all rows reach PSRAM.
+dpi_source = driver.read_text(encoding='utf-8')
+cpu_marker = '/* TAB5 bounded CPU framebuffer copy */'
+if cpu_marker not in dpi_source:
+    start = '        // please note, we assume the user provided draw_buffer is compact,'
+    stop = '        // invoke the trans done callback'
+    cpu = dpi_source.index('} else if (!dpi_panel->fbcpy_handle) { // copy by CPU')
+    begin = dpi_source.index(start, cpu)
+    end = dpi_source.index(stop, begin)
+    body = """        /* TAB5 bounded CPU framebuffer copy */
+        extern void tab5_lcd_cpu_copy_enable(void) __attribute__((weak));
+        extern void tab5_lcd_copy_begin(unsigned) __attribute__((weak));
+        extern void tab5_lcd_copy_end(void) __attribute__((weak));
+        if (tab5_lcd_cpu_copy_enable) tab5_lcd_cpu_copy_enable();
+        for (int y = y_start; y < y_end;) {
+            int remaining = y_end - y;
+            int rows = remaining > 4 ? 4 : remaining;
+            if (tab5_lcd_copy_begin) tab5_lcd_copy_begin((x_end - x_start) * rows);
+            for (int row = 0; row < rows; ++row) {
+                memcpy(to, from, copy_bytes_per_line);
+                to += bytes_per_line;
+                from += copy_bytes_per_line;
+            }
+            uint8_t *first = frame_buffer + y * bytes_per_line;
+            esp_cache_msync(first, rows * bytes_per_line,
+                            ESP_CACHE_MSYNC_FLAG_DIR_C2M | ESP_CACHE_MSYNC_FLAG_UNALIGNED);
+            if (tab5_lcd_copy_end) tab5_lcd_copy_end();
+            y += rows;
+        }
+"""
+    driver.write_text(dpi_source[:begin] + body + dpi_source[end:], encoding='utf-8')
