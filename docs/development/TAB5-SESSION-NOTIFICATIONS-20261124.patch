+
+static void session_waiting_tick(int64_t now, unsigned client, const char *bound_task, bool input, bool scoped) {
+    enum { WAITING_LIMIT = 80 };
+    static char (*previous)[WAITING_LIMIT][UI_SESSION_ID_SIZE];
+    static unsigned used[2], next_slot[2];
+    if (!previous) previous = codex_alloc(2 * sizeof(*previous));
+    if (!previous) return;
+
+    cJSON *tasks = item(item(shown, client ? "claudeTasks" : "codexTasks"), "tasks");
+    cJSON *task = NULL;
+    cJSON_ArrayForEach(task, tasks) {
+        const char *id = text(task, "id");
+        if (!session_id_valid(id)) continue;
+        bool current = !strcmp(text(task, "state"), "waiting") ||
+            !strcmp(text(task, "companionState"), "waiting") || (input && !strcmp(id, bound_task));
+        unsigned index = 0;
+        while (index < used[client] && strcmp(previous[client][index], id)) index++;
+        if (index < used[client]) {
+            if (!current && index != --used[client])
+                memcpy(previous[client][index], previous[client][used[client]], UI_SESSION_ID_SIZE);
+            continue;
+        }
+        if (!current) continue;
+        unsigned slot = used[client] < WAITING_LIMIT ? used[client]++ : next_slot[client]++ % WAITING_LIMIT;
+        memcpy(previous[client][slot], id, UI_SESSION_ID_SIZE);
+        if (scoped && !session_is_muted(client, id)) task_status_banner(now, client, id, true);
+    }
+}
