+static const char *session_mutes_key(unsigned client) {
+    return client ? "claude_mutes" : "codex_mutes";
+}
+
+bool ui_session_mutes_load(unsigned client, ui_session_mutes *value) {
+    value->count = 0;
+    nvs_handle_t handle;
+    esp_err_t result = nvs_open("aibot_tab5", NVS_READONLY, &handle);
+    if (result == ESP_ERR_NVS_NOT_FOUND) return true;
+    if (result != ESP_OK) return false;
+
+    size_t length = sizeof(value->ids);
+    result = nvs_get_blob(handle, session_mutes_key(client), value->ids, &length);
+    nvs_close(handle);
+    if (result == ESP_ERR_NVS_NOT_FOUND) return true;
+    if (result != ESP_OK || length > sizeof(value->ids) || length % UI_SESSION_ID_SIZE) return false;
+    for (size_t i = 0; i < length / UI_SESSION_ID_SIZE; i++) {
+        if (strnlen(value->ids[i], UI_SESSION_ID_SIZE) != UI_SESSION_ID_SIZE - 1) return false;
+    }
+    value->count = length / UI_SESSION_ID_SIZE;
+    return true;
+}
+
+bool ui_session_mutes_save(unsigned client, const ui_session_mutes *value) {
+    if (value->count > UI_MUTED_SESSION_LIMIT) return false;
+    nvs_handle_t handle;
+    if (nvs_open("aibot_tab5", NVS_READWRITE, &handle) != ESP_OK) return false;
+    const char *key = session_mutes_key(client);
+    esp_err_t result = value->count
+        ? nvs_set_blob(handle, key, value->ids, value->count * UI_SESSION_ID_SIZE)
+        : nvs_erase_key(handle, key);
+    if (result == ESP_ERR_NVS_NOT_FOUND && !value->count) result = ESP_OK;
+    if (result == ESP_OK) result = nvs_commit(handle);
+    nvs_close(handle);
+    return result == ESP_OK;
+}
