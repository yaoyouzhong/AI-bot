+static lv_obj_t *session_bells[8], *session_bell_slash[8];
+static void session_unread_style(void);
+static ui_session_mutes session_mutes[2];
+static bool session_mutes_loaded[2];
+static unsigned session_banner_client;
+static char session_chime_task[2][UI_SESSION_ID_SIZE];
