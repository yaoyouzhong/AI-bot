+static const char reminder_save_error[] = "提醒设置保存失败，请重试";
+static const char reminder_limit_error[] = "静音会话已满，请先恢复一个会话的提醒";
+
+static bool session_id_valid(const char *task) { return strlen(task) == UI_SESSION_ID_SIZE - 1; }
+
+static size_t session_mute_index(unsigned client, const char *task) {
+    const ui_session_mutes *value = &session_mutes[client];
+    for (size_t i = 0; i < value->count; i++)
+        if (!strcmp(value->ids[i], task)) return i;
+    return value->count;
+}
+
+static bool session_is_muted(unsigned client, const char *task) {
+    return session_mute_index(client, task) < session_mutes[client].count;
+}
+
+static bool workspace_has_muted_session(unsigned client, const char *bound_task) {
+    if (!session_mutes[client].count) return false;
+    if (session_is_muted(client, bound_task)) return true;
+
+    cJSON *tasks = item(item(shown, client ? "claudeTasks" : "codexTasks"), "tasks");
+    cJSON *task = NULL;
+    cJSON_ArrayForEach(task, tasks) {
+        if (session_is_muted(client, text(task, "id"))) return true;
+    }
+    return false;
+}
+
+static void session_mutes_load(void) {
+    for (unsigned client = 0; client < 2; client++)
+        session_mutes_loaded[client] = ui_session_mutes_load(client, &session_mutes[client]);
+}
+
+static bool session_bell_refresh(int row, bool selected) {
+    bool muted = session_is_muted(workspace_client, codex_task_ids[row]);
+    bool show = session_id_valid(codex_task_ids[row]) && (selected || muted);
+    visible(session_bells[row], show);
+    visible(session_bell_slash[row], muted);
+    tint(lv_obj_get_child(session_bells[row], 0), muted ? MUTED : INK);
+    return show;
+}
+
+static void session_reminder_clicked(lv_event_t *event) {
+    int row = (int)(intptr_t)lv_event_get_user_data(event);
+    const char *task = codex_task_ids[row];
+    if (!session_id_valid(task)) return;
+    unsigned client = workspace_client;
+    ui_session_mutes *value = &session_mutes[client];
+    if (!session_mutes_loaded[client]) {
+        session_mutes_loaded[client] = ui_session_mutes_load(client, value);
+        if (!session_mutes_loaded[client]) {
+            ui_text(codex_voice_hint, reminder_read_error);
+            return;
+        }
+    }
+
+    size_t index = session_mute_index(client, task);
+    bool muting = index == value->count;
+    if (muting) {
+        if (value->count == UI_MUTED_SESSION_LIMIT) {
+            ui_text(codex_voice_hint, reminder_limit_error);
+            return;
+        }
+        memcpy(value->ids[value->count++], task, UI_SESSION_ID_SIZE);
+    } else {
+        value->count--;
+        if (index != value->count)
+            memcpy(value->ids[index], value->ids[value->count], UI_SESSION_ID_SIZE);
+    }
+
+    if (!ui_session_mutes_save(client, value)) {
+        if (muting) value->count--;
+        else {
+            if (index != value->count)
+                memcpy(value->ids[value->count], value->ids[index], UI_SESSION_ID_SIZE);
+            value->count++;
+            memcpy(value->ids[index], task, UI_SESSION_ID_SIZE);
+        }
+        ui_text(codex_voice_hint, reminder_save_error);
+    } else {
+        const char *hint = lv_label_get_text(codex_voice_hint);
+        if (!strcmp(hint, reminder_read_error) || !strcmp(hint, reminder_save_error) || !strcmp(hint, reminder_limit_error))
+            ui_text(codex_voice_hint, "");
+        if (muting) {
+            if (session_banner_client == client && !strcmp(session_banner_task, task))
+                alert_until = 0;
+            if (!strcmp(session_chime_task[client], task))
+                voice_remote_cancel_reply(client != 0);
+        }
+    }
+    session_unread_style();
+}
+
+static void session_bell_create(lv_obj_t *parent, int row) {
+    lv_obj_t *bell = button(parent, LV_SYMBOL_BELL, 258, 4, 52, session_reminder_clicked, row);
+    session_bells[row] = bell;
+    lv_obj_set_height(bell, 52);
+    lv_obj_set_style_radius(bell, LV_RADIUS_CIRCLE, 0);
+    lv_obj_remove_flag(bell, LV_OBJ_FLAG_EVENT_BUBBLE | LV_OBJ_FLAG_SCROLLABLE);
+    ui_bg_opa(bell, LV_OPA_TRANSP, 0);
+    lv_obj_t *glyph = lv_obj_get_child(bell, 0);
+    ui_text_font(glyph, &lv_font_montserrat_24, 0);
+    lv_obj_center(glyph);
+    static const lv_point_precise_t points[] = {{0, 0}, {23, 24}};
+    lv_obj_t *slash = session_bell_slash[row] = lv_line_create(bell);
+    lv_line_set_points(slash, points, 2);
+    lv_obj_set_pos(slash, 15, 14);
+    lv_obj_set_style_line_color(slash, lv_color_hex(INK), 0);
+    lv_obj_set_style_line_width(slash, 3, 0);
+    lv_obj_set_style_line_rounded(slash, true, 0);
+    lv_obj_remove_flag(slash, LV_OBJ_FLAG_CLICKABLE | LV_OBJ_FLAG_SCROLLABLE);
+    visible(bell, false);
+}
diff --git a/tests/ui-preview/session_notifications_test.h b/tests/ui-preview/session_notifications_test.h
new file mode 100644
index 0000000..0bfe9ac
--- /dev/null
+++ b/tests/ui-preview/session_notifications_test.h
@@ -0,0 +1,132 @@
+static void check_session_notifications(void) {
+    static const char *keys[] = {"codexTasks", "claudeTasks"};
+    static const char *models[] = {"codex", "claude"};
+    static const char *ids[2][2] = {
+        {"11111111-1111-4111-8111-111111111111", "22222222-2222-4222-8222-222222222222"},
+        {"33333333-3333-4333-8333-333333333333", "44444444-4444-4444-8444-444444444444"},
+    };
+    lv_indev_t *touch = lv_indev_create();
+    lv_indev_set_type(touch, LV_INDEV_TYPE_POINTER);
+    lv_indev_set_display(touch, lv_display_get_default());
+    lv_indev_set_read_cb(touch, camera_touch_read);
+
+    for (unsigned client = 0; client < 2; client++) {
+        reply_open_state_setup(client);
+        cJSON *remote = item(shown, keys[client]);
+        cJSON *tasks = item(remote, "tasks"), *first = cJSON_GetArrayItem(tasks, 0);
+        cJSON_ReplaceItemInObject(first, "id", cJSON_CreateString(ids[client][0]));
+        cJSON_ReplaceItemInObject(first, "title", cJSON_CreateString("本会话关闭提醒"));
+        cJSON *other = cJSON_Duplicate(first, true);
+        cJSON_ReplaceItemInObject(other, "id", cJSON_CreateString(ids[client][1]));
+        cJSON_ReplaceItemInObject(other, "title", cJSON_CreateString("同项目正常提醒"));
+        cJSON_AddItemToArray(tasks, other);
+        codex_select_task(ids[client][0]);
+        render_codex();
+        lv_obj_update_layout(lv_screen_active());
+
+        lv_area_t target, glyph, row;
+        lv_obj_get_coords(session_bells[0], &target);
+        lv_obj_get_coords(lv_obj_get_child(session_bells[0], 0), &glyph);
+        lv_obj_get_coords(codex_task_rows[0], &row);
+        assert(lv_area_get_width(&target) == 52 && lv_area_get_height(&target) == 52);
+        assert(glyph.x1 > target.x1 && glyph.x2 < target.x2 && glyph.y1 > target.y1 && glyph.y2 < target.y2);
+        assert(target.x2 < row.x2 && target.y2 < row.y2);
+        lv_font_glyph_dsc_t bell_glyph;
+        assert(lv_font_get_glyph_dsc(&lv_font_montserrat_24, &bell_glyph, 0xF0F3, 0));
+        lv_point_t center = {(target.x1 + target.x2) / 2, (target.y1 + target.y2) / 2};
+        assert(lv_obj_has_flag(session_bell_slash[0], LV_OBJ_FLAG_HIDDEN));
+
+        preview_session_mutes_save_failure = true;
+        gallery_pointer_click(touch, center);
+        assert(!session_is_muted(client, ids[client][0]));
+        assert(lv_obj_has_flag(session_bell_slash[0], LV_OBJ_FLAG_HIDDEN));
+        preview_session_mutes_save_failure = false;
+        gallery_pointer_click(touch, center);
+        assert(session_is_muted(client, ids[client][0]));
+        assert(!session_is_muted(client, ids[client][1]));
+        assert(!session_is_muted(client ^ 1, ids[client][0]));
+        assert(!lv_obj_has_flag(session_bell_slash[0], LV_OBJ_FLAG_HIDDEN));
+        assert(!strcmp(codex_selected, ids[client][0]));
+        memset(session_mutes, 0, sizeof(session_mutes));
+        session_mutes_load();
+        assert(session_is_muted(client, ids[client][0]));
+
+        cJSON *ready = cJSON_AddObjectToObject(remote, "repliesReady");
+        cJSON_AddStringToObject(ready, ids[client][0], "first-muted-reply");
+        cJSON *model = item(shown, models[client]);
+        cJSON_AddBoolToObject(model, "completionActive", true);
+        cJSON_AddNumberToObject(model, "completionSequence", 1);
+        if (client) {
+            cJSON *bound = cJSON_AddObjectToObject(shown, "claudeSession");
+            cJSON_AddStringToObject(bound, "taskId", ids[client][0]);
+        }
+        alert_until = 0;
+        codex_notices_ready = true;
+        unsigned chimes = preview_chimes;
+        alerts(3000, true);
+        codex_notice_tick(3000, true);
+        alert_visual_tick(3000);
+        render_codex();
+        assert(preview_chimes == chimes && !alert_until && !lv_label_get_text(banner)[0]);
+        assert(session_unread_count(client, NULL) == 1);
+        assert(session_unread_task(ids[client][0]));
+        assert(!lv_obj_has_flag(codex_unread_dot, LV_OBJ_FLAG_HIDDEN));
+        assert(!lv_obj_has_flag(session_unread_rows[0], LV_OBJ_FLAG_HIDDEN));
+        capture(client ? "session-claude-muted-unread" : "session-codex-muted-unread");
+        codex_select_task(ids[client][1]);
+        render_codex();
+        assert(!lv_obj_has_flag(session_bells[0], LV_OBJ_FLAG_HIDDEN));
+        assert(!lv_obj_has_flag(session_bell_slash[0], LV_OBJ_FLAG_HIDDEN));
+        assert(!lv_obj_has_flag(session_bells[1], LV_OBJ_FLAG_HIDDEN));
+        assert(lv_obj_has_flag(session_bell_slash[1], LV_OBJ_FLAG_HIDDEN));
+        capture(client ? "session-claude-mixed" : "session-codex-mixed");
+        codex_select_task(ids[client][0]);
+        render_codex();
+
+        // A muted arrival later in the batch must leave the unmuted banner's target intact.
+        cJSON_DeleteItemFromObject(ready, ids[client][0]);
+        cJSON_AddStringToObject(ready, ids[client][1], "normal-reply");
+        cJSON_AddStringToObject(ready, ids[client][0], "second-muted-reply");
+        codex_notice_tick(4000, true);
+        assert(preview_chimes == chimes + 1 && preview_reply_client == (int)client);
+        assert(!strcmp(codex_alert_task, ids[client][1]) && alert_until == 14000);
+        assert(session_unread_count(client, NULL) == 2);
+
+        alert_until = 0;
+        cJSON_AddStringToObject(first, "state", "waiting");
+        cJSON_AddBoolToObject(model, "needsInput", true);
+        alerts(5000, true);
+        assert(!alert_until);
+        cJSON_AddStringToObject(other, "state", "waiting");
+        alerts(6000, true);
+        assert(alert_until == 16000 && alert_attention);
+        assert(!strcmp(session_banner_task, ids[client][1]));
+        alerts(6500, true);
+        assert(alert_until == 16000);
+
+        gallery_pointer_click(touch, center);
+        assert(!session_is_muted(client, ids[client][0]));
+        assert(lv_obj_has_flag(session_bell_slash[0], LV_OBJ_FLAG_HIDDEN));
+        assert(session_unread_task(ids[client][0]));
+        cJSON_ReplaceItemInObject(ready, ids[client][0], cJSON_CreateString("restored-reply"));
+        codex_notice_tick(7000, true);
+        assert(preview_chimes == chimes + 2 && !strcmp(codex_alert_task, ids[client][0]));
+        alert_visual_tick(7000);
+        capture(client ? "session-claude-reminders-restored" : "session-codex-reminders-restored");
+        assert(preview_reply_pending[client]);
+        gallery_pointer_click(touch, center);
+        assert(session_is_muted(client, ids[client][0]));
+        assert(!preview_reply_pending[client] && alert_until == 0);
+        assert(session_unread_task(ids[client][0]));
+
+        // Archived or unrelated rules cannot hide a provider-wide reminder.
+        cJSON_DeleteItemFromArray(tasks, 0);
+        cJSON_DeleteItemFromObject(shown, "claudeSession");
+        cJSON_ReplaceItemInObject(model, "needsInput", cJSON_CreateFalse());
+        cJSON_ReplaceItemInObject(model, "completionSequence", cJSON_CreateNumber(2));
+        alerts(8000, true);
+        assert(alert_until == 18000 && !alert_attention);
+    }
+    lv_indev_delete(touch);
+    puts("SESSION_NOTIFICATIONS_OK pointer, independent settings, storage failure/reload, unread, banner and chime, batching, waiting transitions and restore");
+}
