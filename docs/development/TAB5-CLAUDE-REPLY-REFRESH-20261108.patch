+// A visible, actively generating Claude reply benefits from a shorter poll.
+// Completed, hidden, unknown and history views keep the existing cadence.
+static int codex_success_read_interval(bool running) {
+    if(codex_reply_selected[0]&&!codex_reply_follow)return 15000;
+    if(workspace_client&&codex_reply_follow&&running&&codex_reply_overlay&&
+       !lv_obj_has_flag(codex_reply_overlay,LV_OBJ_FLAG_HIDDEN))return 750;
+    return 3000;
+}
