+static void workspace_tabs_layout(lv_obj_t *strip,lv_obj_t *const tabs[],const bool available[],unsigned total,unsigned selected) {
+    unsigned count=0;
+    for(unsigned i=0;i<total;i++)if(available[i])count++;
+    bool overflow=count>WORKSPACE_TAB_MAX_VISIBLE;
+    if(overflow!=lv_obj_has_flag(strip,LV_OBJ_FLAG_SCROLLABLE)) {
+        if(overflow)lv_obj_add_flag(strip,LV_OBJ_FLAG_SCROLLABLE);
+        else {lv_obj_scroll_to_x(strip,0,LV_ANIM_OFF);lv_obj_remove_flag(strip,LV_OBJ_FLAG_SCROLLABLE);}
+        lv_obj_set_scrollbar_mode(strip,overflow?LV_SCROLLBAR_MODE_ON:LV_SCROLLBAR_MODE_OFF);
+    }
+    int space=WORKSPACE_TAB_WIDTH-(int)(count?count-1:0)*WORKSPACE_TAB_GAP;
+    int x=0,rank=0;
+    for(unsigned i=0;i<total;i++) {
+        lv_obj_t *tab=tabs[i];
+        visible(tab,available[i]);
+        if(!available[i])continue;
+        int w=overflow?78:space/(int)count+(rank<space%(int)count);
+        session_source_pos(tab,x,0);
+        session_source_width(tab,w);
+        lv_obj_t *icon=lv_obj_get_child(tab,0);
+        bool narrow=count>=WORKSPACE_TAB_MAX_VISIBLE;
+        int scale=narrow?228:256;
+        if(lv_image_get_scale(icon)!=scale)lv_image_set_scale(icon,scale);
+        if(lv_obj_get_style_align(icon,0)!=LV_ALIGN_CENTER||lv_obj_get_style_x(icon,0)!=(narrow?-8:0))
+            lv_obj_align(icon,LV_ALIGN_CENTER,narrow?-8:0,0);
+        workspace_tab_select(tab,i==selected);
+        x+=w+WORKSPACE_TAB_GAP;
+        rank++;
+    }
+}
