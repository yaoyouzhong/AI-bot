+    // This proof precedes USB standby and never marks display state as delivered.
+    // Keep the existing serial queue and shared sequence allocator.
+    private func sendOwnerProof(_ pair: MacTab5Pairing, nonce: String) {
+        guard let peer, let input = characteristics[MacTab5BLEWire.input] else { reset("蓝牙归属服务不可用"); return }
+        do {
+            let snapshot = try MacTab5Protocol.object(service.frame())
+            guard let sequence = MacTab5Protocol.integer(snapshot["sequence"]) else { throw MacTab5Error.invalidPacket }
+            let clear = try MacTab5BLEWire.ownershipProof(pair, sequence: sequence)
+            let packet = try MacTab5Protocol.encrypt(clear, key: pair.key, challenge: nonce)
+            busy = true; deadline = now + 15
+            write(try MacTab5BLEWire.fragments(packet, maximum: writeMaximum(peer), lengthPrefix: true), to: input) { [weak self] result in
+                guard let self else { return }
+                do { try result.get(); self.confirmOwner(pair, nonce: nonce, sequence: sequence, attempts: 0) }
+                catch { self.reset("蓝牙归属证明未确认，等待重连") }
+            }
+        } catch { reset("蓝牙归属证明不可用") }
+    }
+    private func confirmOwner(_ pair: MacTab5Pairing, nonce: String, sequence: Int64, attempts: Int) {
+        guard enabled, self.nonce == nonce, authenticatedDevice == pair.deviceId,
+              let current = service.currentPairing, MacTab5HostBinding.id(current) == MacTab5HostBinding.id(pair) else { return }
+        guard let info = characteristics[MacTab5BLEWire.info] else { reset("蓝牙服务已断开"); return }
+        read(info) { [weak self] result in
+            guard let self else { return }
+            do {
+                let (_, ack, _) = try MacTab5BLEWire.authenticate(result.get(), pair: pair, nonce: nonce)
+                if ack != sequence {
+                    guard attempts < 15 else { throw MacTab5Error.unconfirmed }
+                    self.queue.asyncAfter(deadline: .now() + 0.1) { [weak self] in
+                        self?.confirmOwner(pair, nonce: nonce, sequence: sequence, attempts: attempts + 1)
+                    }; return
+                }
+                self.busy = false
+                self.service.bleState("电脑归属已确认")
+            } catch { self.reset("蓝牙归属确认失败，等待重连") }
+        }
+    }
