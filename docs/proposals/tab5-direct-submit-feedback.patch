--- /dev/null
+++ b/firmware/main/desktop_submit_feedback.h
@@ -0,0 +1,18 @@
+#pragma once
+#include "cJSON.h"
+#include <string.h>
+
+// Only a typed, target-bound no-action receipt can prove that nothing was sent.
+// Old bridges, lost replies and malformed receipts keep the unknown outcome.
+static const char *desktop_submit_feedback(int status,const cJSON *reply,const char *task_id) {
+    const cJSON *target=cJSON_GetObjectItemCaseSensitive(reply,"taskId");
+    if(status!=409||!task_id||strlen(task_id)!=36||!cJSON_IsString(target)||strcmp(target->valuestring,task_id)||
+       !cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply,"submitted"))||
+       !cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply,"attempted")))
+        return "未确认发送，请检查电脑；不要重复发送，可重新录音";
+    const cJSON *value=cJSON_GetObjectItemCaseSensitive(reply,"error");
+    const char *error=cJSON_IsString(value)?value->valuestring:"";
+    if(!strcmp(error,"staged_target_or_text_changed")||!strcmp(error,"composer_changed"))
+        return "未发送，请核对题目和文字后重新录音";
+    return "未发送，电脑尚未就绪，请检查后重新录音";
+}
--- /dev/null
+++ b/tests/ui-preview/desktop_submit_feedback_test.c
@@ -0,0 +1,31 @@
+#include <assert.h>
+#include <stdio.h>
+#include "../../firmware/main/desktop_submit_feedback.h"
+
+int main(void) {
+    const char *id="11111111-1111-1111-1111-111111111111";
+    cJSON *reply=cJSON_Parse("{\"taskId\":\"11111111-1111-1111-1111-111111111111\",\"submitted\":false,\"attempted\":false,\"error\":\"staged_target_or_text_changed\"}");
+    assert(reply);
+    assert(strstr(desktop_submit_feedback(409,reply,id),"未发送，请核对题目和文字"));
+    cJSON_SetValuestring(cJSON_GetObjectItemCaseSensitive(reply,"error"),"composer_changed");
+    assert(strstr(desktop_submit_feedback(409,reply,id),"未发送，请核对题目和文字"));
+    cJSON_SetValuestring(cJSON_GetObjectItemCaseSensitive(reply,"error"),"native_submit_unavailable");
+    assert(strstr(desktop_submit_feedback(409,reply,id),"未发送，电脑尚未就绪"));
+    assert(strstr(desktop_submit_feedback(409,reply,"22222222-2222-2222-2222-222222222222"),"未确认发送"));
+    assert(strstr(desktop_submit_feedback(200,reply,id),"未确认发送"));
+    assert(strstr(desktop_submit_feedback(0,NULL,id),"未确认发送"));
+    cJSON_ReplaceItemInObjectCaseSensitive(reply,"attempted",cJSON_CreateTrue());
+    assert(strstr(desktop_submit_feedback(409,reply,id),"不要重复发送"));
+    cJSON_ReplaceItemInObjectCaseSensitive(reply,"attempted",cJSON_CreateString("false"));
+    assert(strstr(desktop_submit_feedback(409,reply,id),"未确认发送"));
+    cJSON_DeleteItemFromObjectCaseSensitive(reply,"attempted");
+    assert(strstr(desktop_submit_feedback(409,reply,id),"未确认发送"));
+    cJSON_AddFalseToObject(reply,"attempted");
+    cJSON_ReplaceItemInObjectCaseSensitive(reply,"submitted",cJSON_CreateTrue());
+    assert(strstr(desktop_submit_feedback(409,reply,id),"未确认发送"));
+    cJSON_DeleteItemFromObjectCaseSensitive(reply,"submitted");
+    assert(strstr(desktop_submit_feedback(409,reply,id),"未确认发送"));
+    cJSON_Delete(reply);
+    puts("DESKTOP_SUBMIT_FEEDBACK_OK cases=11 changed_text no_action unknown malformed old_bridge wrong_target");
+    return 0;
+}
