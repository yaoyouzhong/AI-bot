<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsSdkPackageVersion>10.0.22000.56</WindowsSdkPackageVersion>
    <AssemblyName>AIBotBridge</AssemblyName>
    <RootNamespace>AIBotBridge</RootNamespace>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Version>0.6.13</Version>
    <LocalArt Condition="'$(LocalArt)' == ''">false</LocalArt>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AIBotLoginHelper/AIBotLoginHelper.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;OutputPath;OutDir;PublishDir;PublishSingleFile" />
    <Compile Include="../AIBotLoginHelper/HelperContract.cs" Link="LoginMethodHelperContract.cs" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <EmbeddedResource Include="Assets\app-icon.ico" />
    <EmbeddedResource Include="Assets\flash-icon.ico" />
    <EmbeddedResource Include="../../licenses/font-awesome/OFL.txt" LogicalName="AIBotBridge.FontAwesome.OFL" />
    <EmbeddedResource Include="../../licenses/font-awesome/LICENSE.txt" LogicalName="AIBotBridge.FontAwesome.Notice" />
    <EmbeddedResource Include="Assets\runtime-health.wav" LogicalName="AIBotBridge.RuntimeHealthSound" />
    <EmbeddedResource Include="../../docs/art-guides/catalog.zh.json" LogicalName="AIBotBridge.ArtGuides" WithCulture="false" Condition="'$(LocalArt)' == 'true'" />
    <EmbeddedResource Include="../../CHANGELOG.zh.md" LogicalName="AIBotBridge.Notes.bridge" WithCulture="false" />
    <EmbeddedResource Include="../../docs/development/TAB5-CHANGELOG.zh.md" LogicalName="AIBotBridge.Notes.tab5" WithCulture="false" />
    <EmbeddedResource Include="../../firmware/CHANGELOG.zh.md" LogicalName="AIBotBridge.Notes.esp8266" WithCulture="false" />
    <Content Include="Assets\flash-icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\DailyArt\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(LocalArt)' == 'true'" />
    <Content Include="TestFixtures\claude_sprite.h" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/pdfpig/*" Link="licenses/pdfpig/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/pmo-calendar/NOTICE.md" Link="licenses/pmo-calendar/NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyLoginHelper" AfterTargets="Build">
    <ItemGroup>
      <LoginHelperFiles Include="../AIBotLoginHelper/bin/$(Configuration)/net8.0-windows/AIBotLoginHelper.exe;../AIBotLoginHelper/bin/$(Configuration)/net8.0-windows/AIBotLoginHelper.dll;../AIBotLoginHelper/bin/$(Configuration)/net8.0-windows/AIBotLoginHelper.deps.json;../AIBotLoginHelper/bin/$(Configuration)/net8.0-windows/AIBotLoginHelper.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(LoginHelperFiles)" DestinationFolder="$(TargetDir)LoginHelper" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishLoginHelper" AfterTargets="Publish" DependsOnTargets="CopyLoginHelper">
    <Copy SourceFiles="@(LoginHelperFiles)" DestinationFolder="$(PublishDir)LoginHelper" SkipUnchangedFiles="true" />
  </Target>
</Project>
